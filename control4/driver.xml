    <commands>
      <command>
        <name>Set Channel</name>
        <description>Set raw DMX channel PARAM1 to PARAM2 (0-255), bypassing the fixture slots</description>
        <params>
          <param><name>Channel</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>512</maximum></param>
          <param><name>Value</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>255</maximum></param>
        </params>
      </command>
      <command>
        <name>Set Fixture Colour</name>
        <description>Set fixture PARAM1 to R PARAM2 G PARAM3 B PARAM4 (0-255) over PARAM5 ms (0 = every fixture)</description>
        <params>
          <param><name>Fixture</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>16</maximum></param>
          <param><name>Red</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>255</maximum></param>
          <param><name>Green</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>255</maximum></param>
          <param><name>Blue</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>255</maximum></param>
          <param><name>Fade ms</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>60000</maximum></param>
        </params>
      </command>
      <command>
        <name>Set Fixture Level</name>
        <description>Set fixture PARAM1 to PARAM2 % over PARAM3 ms (0 = every fixture)</description>
        <params>
          <param><name>Fixture</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>16</maximum></param>
          <param><name>Level</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>100</maximum></param>
          <param><name>Fade ms</name><type>RANGED_INTEGER</type><minimum>0</minimum><maximum>60000</maximum></param>
        </params>
      </command>
      <command>
        <name>Blackout</name>
        <description>Blackout PARAM1 (every DMX channel to 0 / restore the last look)</description>
        <params><param><name>State</name><type>LIST</type><items><item>On</item><item>Off</item></items></param></params>
      </command>
      <command>
        <name>Identify Fixture</name>
        <description>Flash fixture PARAM1 white three times, then restore</description>
        <params><param><name>Fixture</name><type>RANGED_INTEGER</type><minimum>1</minimum><maximum>16</maximum></param></params>
      </command>
    </commands>

